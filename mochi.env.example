# Copy to mochi.env and fill in. mochi.env is git-ignored; build.sh and release.sh read it.
# Everything is optional: with nothing set you get a local-only, ad-hoc signed Mochi.

# Your own reverse-DNS bundle id. The iPhone app uses <this>.ios.
MOCHI_BUNDLE_ID=com.example.mochi

# Code signing identity ("security find-identity -v -p codesigning" lists yours).
# "-" signs ad hoc: it works, but macOS asks for the microphone and system audio permissions
# again after every rebuild, and the in-app updater stays off.
MOCHI_SIGN_IDENTITY=-

# iPhone app only: your Apple Developer team id.
MOCHI_TEAM_ID=

# Sync, sign-in, the Claude connector and updates: your own Supabase project.
# Leave empty to run local only.
MOCHI_SUPABASE_URL=
MOCHI_SUPABASE_KEY=
